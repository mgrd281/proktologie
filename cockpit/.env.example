# ---- Praxis-Cockpit – Umgebungsvariablen (Vercel-Projekt "cockpit", Region fra1) ----

# Postgres in Frankfurt (Neon, eu-central-1). Leer lassen = lokale PGlite-Datei
# unter .pglite/ (nur Entwicklung/Tests, niemals produktiv).
DATABASE_URL=

# Öffentliche Basis-URL des Cockpits (Passkeys: rpID = Hostname dieser URL;
# Verwaltungslinks in Patienten-Mails zeigen auf <COCKPIT_URL>/t/#…)
COCKPIT_URL=http://localhost:3100

# Geheimnisse – jeweils 32+ zufällige Bytes, z. B. `openssl rand -base64 48`
BETTER_AUTH_SECRET=
# Feldverschlüsselung (AES-256-GCM); Rotation über DATA_KEY_V2 + rotate-key-Skript
DATA_KEY_V1=
# Blind-Indizes (HMAC) für Suche ohne Entschlüsselung
INDEX_KEY=

# ---- Phase 1: öffentliche Buchung, Versand, Automatik ----

# Ursprünge der Website, die die öffentliche API aufrufen dürfen (CORS), kommagetrennt.
# Ohne Angabe: proktologie.vercel.app, www.proktologie-eimsbuettel.de, localhost:3000
SITE_ORIGINS=

# Herzschlag der Automatik: POST /api/internal/tick mit "Authorization: Bearer <CRON_SECRET>".
# Vercel Cron (vercel.json, täglich – mehr erlaubt der Hobby-Plan nicht) schickt
# den Wert automatisch als Bearer mit; GitHub Actions alle 15 Minuten dazu
# (siehe .github/workflows/cockpit-tick.yml). Ohne Wert: Route existiert nicht.
CRON_SECRET=

# Betriebsgeheimnis für zwei Routen, die innerhalb der laufenden Vercel-Funktion
# arbeiten (dort, wo ein "sensitive" DATABASE_URL tatsächlich existiert):
#   POST /api/internal/migrate   – Migrationen ausführen
#   POST /api/internal/settings  – Online-Buchung schalten { bookingLive, bookingPaused, bannerText }
# jeweils mit "Authorization: Bearer <MIGRATE_SECRET>".
MIGRATE_SECRET=

# Ersten Administrator anlegen (nur einmalig – lokal per `npm run db:bootstrap-admin`,
# oder aus demselben Grund wie oben ferngesteuert per
# POST /api/internal/bootstrap-admin mit "Authorization: Bearer <BOOTSTRAP_ADMIN_SECRET>",
# kein Body). Nach dem ersten Konto beide Variablen wieder entfernen.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_SECRET=

# Formular-Token der Website (HMAC); leer = BETTER_AUTH_SECRET wird verwendet
FORM_TOKEN_SECRET=

# E-Mail-Versand: EMAIL_PROVIDER=brevo + EMAIL_API_KEY → echter Versand (EU-Anbieter, AVV).
# Ohne Schlüssel: Protokoll-Modus, keine Mail verlässt das System.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=termine@proktologie-eimsbuettel.de
EMAIL_FROM_NAME=Proktologie Eimsbüttel
# Nur Entwicklung/Tests: Ablage der protokollierten Mails als JSON
MAIL_OUTBOX_DIR=.mail-outbox

# ---- Chat-Assistent (Website-Widget + POST /api/public/v1/chat) ----

# Zwei kostenlose Anbieter, NVIDIA zuerst, OpenRouter als Reserve. Ein Anbieter
# ohne Schlüssel wird ohne einen einzigen Netzaufruf übersprungen; ohne beide
# funktionieren alle Wege über Schaltflächen weiter, nur freier Text bekommt
# den ehrlichen Satz „kann ich gerade nicht beantworten“.
NVIDIA_API_KEY=
OPENROUTER_API_KEY=

# Modellkette, kommagetrennt als "anbieter:modell". Standard siehe lib/chat/llm.ts.
# GELDSCHUTZ: Bei OpenRouter sind ausschließlich Modell-Ids mit ":free" erlaubt –
# alles andere wird verworfen, zweimal geprüft (beim Lesen der Kette und
# unmittelbar vor dem fetch).
CHAT_MODEL_CHAIN=

# Endpunkte überschreiben (nur Tests; e2e/fake-llm.mjs)
CHAT_NVIDIA_BASE_URL=
CHAT_OPENROUTER_BASE_URL=

# Fristen: je Aufruf und für die ganze Kette
CHAT_LLM_TIMEOUT_MS=8000
CHAT_LLM_BUDGET_MS=20000

# ---- Sprachkanal: Mikrofon im Chatfenster ----

# EIN Schlüssel schaltet das Mikrofon an. Fehlt er, meldet /status
# voice:false und die Website zeigt gar keinen Knopf – es gibt keinen
# halben Zustand, in dem ein Mikrofon da ist und nichts passiert.
#
# Der Schlüssel bleibt auf dem Server. Der Browser bekommt über
# POST /api/public/v1/voice/token nur ein kurzlebiges Geheimnis (ek_…) und
# spricht damit direkt mit OpenAI – kein eigener Rechner dazwischen, der
# mithören könnte, und kein Schlüssel im Browser.
#
# Angefordert wird ausdrücklich eine TRANSKRIPTIONS-Sitzung: Die kann
# strukturell nicht selbst antworten. Damit ist bewiesen, nicht nur
# versprochen, dass jede Antwort aus unserem Automaten kommt – mit
# Notfallpfad, Gesundheitsfilter und echter Verfügbarkeit.
#
# VOR DEM SCHARFSCHALTEN FÜR ECHTE PATIENTEN: Gesprochenes ist eine
# Gesundheitsangabe. Dafür braucht die Praxis einen AVV mit OpenAI, einen
# Eintrag im Verzeichnis der Verarbeitungstätigkeiten und eine DSFA.
# Siehe docs/sprachkanal-openai.md.
OPENAI_API_KEY=
# Nur für Tests: anderen Endpunkt ansteuern.
OPENAI_BASE_URL=

# Gesperrte Adressen (kommagetrennt, E-Mail oder Telefon). Verglichen wird über
# die Blind-Indizes; im Speicher landen nur Hashes.
CHAT_BLOCKLIST=

# Kurze Meldung an die Praxis bei Buchung aus dem Chat und bei Rückrufbitten.
# Ohne Angabe: die Adresse aus lib/practice.ts.
EMAIL_PRACTICE_TO=
