# ---- Praxis-Cockpit – Umgebungsvariablen (Vercel-Projekt "cockpit", Region fra1) ----

# Postgres in Frankfurt (Neon, eu-central-1). Leer lassen = lokale PGlite-Datei
# unter .pglite/ (nur Entwicklung/Tests, niemals produktiv).
DATABASE_URL=

# Öffentliche Basis-URL des Cockpits (Passkeys: rpID = Hostname dieser URL;
# Verwaltungslinks in Patienten-Mails zeigen auf <COCKPIT_URL>/t/#…)
COCKPIT_URL=http://localhost:3100

# Geheimnisse – jeweils 32+ zufällige Bytes, z. B. `openssl rand -base64 48`
BETTER_AUTH_SECRET=
# Feldverschlüsselung (AES-256-GCM); Rotation über DATA_KEY_V2 + rotate-key-Skript
DATA_KEY_V1=
# Blind-Indizes (HMAC) für Suche ohne Entschlüsselung
INDEX_KEY=

# ---- Phase 1: öffentliche Buchung, Versand, Automatik ----

# Ursprünge der Website, die die öffentliche API aufrufen dürfen (CORS), kommagetrennt.
# Ohne Angabe: proktologie.vercel.app, www.proktologie-eimsbuettel.de, localhost:3000
SITE_ORIGINS=

# Herzschlag der Automatik: POST /api/internal/tick mit "Authorization: Bearer <CRON_SECRET>"
# (GitHub Actions alle 15 Minuten – siehe .github/workflows/cockpit-tick.yml). Ohne Wert: Route existiert nicht.
CRON_SECRET=

# Migrationen ausführen, wenn DATABASE_URL ein "sensitive" Vercel-Geheimnis ist
# (z. B. Neon-/Supabase-Marketplace-Integration) und deshalb nie lokal auslesbar –
# POST /api/internal/migrate mit "Authorization: Bearer <MIGRATE_SECRET>".
MIGRATE_SECRET=

# Ersten Administrator anlegen (nur einmalig – lokal per `npm run db:bootstrap-admin`,
# oder aus demselben Grund wie oben ferngesteuert per
# POST /api/internal/bootstrap-admin mit "Authorization: Bearer <BOOTSTRAP_ADMIN_SECRET>",
# kein Body). Nach dem ersten Konto beide Variablen wieder entfernen.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_SECRET=

# Formular-Token der Website (HMAC); leer = BETTER_AUTH_SECRET wird verwendet
FORM_TOKEN_SECRET=

# E-Mail-Versand: EMAIL_PROVIDER=brevo + EMAIL_API_KEY → echter Versand (EU-Anbieter, AVV).
# Ohne Schlüssel: Protokoll-Modus, keine Mail verlässt das System.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=termine@proktologie-eimsbuettel.de
EMAIL_FROM_NAME=Proktologie Eimsbüttel
# Nur Entwicklung/Tests: Ablage der protokollierten Mails als JSON
MAIL_OUTBOX_DIR=.mail-outbox
