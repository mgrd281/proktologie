# Buildzeit-Konfiguration (statischer Export: Werte werden beim Build eingebacken)

# Offizielle Doctolib-Buchungsseite des Praxisprofils.
# Die echte Profil-URL der Praxis liegt bereits als Default in
# content/site.ts – diese Variable wird nur zum Überschreiben gebraucht
# (z. B. wenn die Praxis das Profil wechselt).
NEXT_PUBLIC_DOCTOLIB_BOOKING_URL=

# Terminquelle der Booking-UI.
# leer/unangegeben = "request" (Wunschtermin, Praxis bestätigt – Default)
# "cockpit"        = Praxis-Cockpit. Die Karte fragt beim Laden einmal den
#                    Zustand ab: live → echte freie Zeiten, verbindliche
#                    Buchung; nicht live, pausiert oder keine Antwort →
#                    Wunschtermin wie ohne Cockpit. Braucht NEXT_PUBLIC_COCKPIT_API.
# "mock"           = NUR Entwicklung/Screenshots: simulierte Slots,
#                    niemals für den produktiven Build verwenden!
NEXT_PUBLIC_BOOKING_PROVIDER=

# Basis-URL der öffentlichen Cockpit-API ohne Schrägstrich am Ende,
# z. B. https://proktologie-cockpit.vercel.app – nur mit Provider "cockpit".
NEXT_PUBLIC_COCKPIT_API=
