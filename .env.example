# Buildzeit-Konfiguration (statischer Export: Werte werden beim Build eingebacken)

# Offizielle Doctolib-Buchungsseite des Praxisprofils.
# Von der Praxis bereitstellen lassen (https://www.doctolib.de/...).
# Solange leer, werden alle Doctolib-CTAs der Website ausgeblendet.
NEXT_PUBLIC_DOCTOLIB_BOOKING_URL=

# Terminquelle der Booking-UI.
# leer/unangegeben = "request" (Wunschtermin, Praxis bestätigt – Default)
# "mock"           = NUR Entwicklung/Screenshots: simulierte Slots,
#                    niemals für den produktiven Build verwenden!
NEXT_PUBLIC_BOOKING_PROVIDER=
